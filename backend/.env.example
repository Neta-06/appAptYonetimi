# ============================================================
#  appApartman - Örnek Çevre Değişkenleri
#  Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# ============================================================

# --- Uygulama ---
APP_NAME=appApartman
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Veritabanı ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appapartman
DB_ECHO=false

# --- Güvenlik ---
